# Database Credentials
POSTGRES_DB=przetrwaj
POSTGRES_USER=przetrwaj_user
POSTGRES_PASSWORD=your_strong_db_password_here


# JWT Authentication
Jwt__Key=your-very-long-secret-key-at-least-32-characters-long
Jwt__Issuer=przetrwaj.pl
Jwt__Audience=przetrwaj.pl
Jwt__RefreshTokenValidHours=48
Jwt__ValidHours=8


# Frontend URL (For CORS and redirect links)
FrontEnd__Url=http://localhost:7173


# OAuth Google
OAuth__Google__ClientId=
OAuth__Google__ClientSecret=


# Email Settings
Email__CustomSmtp__SmtpServer=
Email__CustomSmtp__SmtpPort=465
Email__CustomSmtp__SSL=true
Email__CustomSmtp__Domain=
Email__CustomSmtp__SenderDisplayName=Przetrwaj.pl
Email__CustomSmtp__UserEmail=
Email__CustomSmtp__UserPassword=

Email__Azure__AzureConnection=
Email__Azure__AzureSender=


# Cache Settings
Cache__BlackListUsersMaxCount=10000
Cache__BlackListTimeSpanHour=8