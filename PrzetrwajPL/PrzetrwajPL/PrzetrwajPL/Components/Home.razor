@page "/"

@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JSRuntime

<PageTitle>Przetrwaj PL</PageTitle>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<div style="text-align: center">
	<h1>
		Ogólnopolska strona do zgłaszania zagrożeń z twojej okolicy.
	</h1>
</div>

<div>
	<p>
		Aktualnie w Polsce śledzimy @($"{statistics?.ActiveDangers ?? 0:n0}") zagrożeń, oraz  @($"{statistics?.ActiveResources ?? 0:n0}") pomocnych punktów z zasobami.
	</p>
	<p>
		Strona posiada  @($"{statistics?.Users ?? 0:n0}") użytkowników, oraz  @($"{statistics?.Moderators ?? 0:n0}") moderatorów.
	</p>
</div>


<div style="text-align: center">
	<h2>Mapa aktualnych zagrożeń i zasobów</h2>
</div>
@* map container with size *@
<div id="@(PolandMapId)" style="height: 800px; width: 100%; margin-top: 20px; border-radius: 8px; border: 1px solid #ccc; z-index: 1;"></div>
