@page "/posts/{PostId}/add-attachments"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using PrzetrwajPL.Components.Pages.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav

<h3>Dodaj zdjęcia do posta #@PostId</h3>

<div class="card p-3 mb-3">
    <ImageAttachments @ref="attachmentsComponent" OnAttachmentsChanged="StateHasChanged" />
</div>

<div class="d-flex gap-2">
    @if (attachmentsComponent != null && attachmentsComponent.Items.Count > 0)
    {
        <button class="btn btn-success" @onclick="UploadAll" disabled="@isUploading">
            @(isUploading ? "Przesyłanie..." : "Wyślij zdjęcia")
        </button>
    }
    <a href="/post/@PostId" class="btn btn-secondary">Pomiń</a>
</div>

@if (!string.IsNullOrEmpty(message))
{
	<div class="alert alert-danger mt-3">@message</div>
}