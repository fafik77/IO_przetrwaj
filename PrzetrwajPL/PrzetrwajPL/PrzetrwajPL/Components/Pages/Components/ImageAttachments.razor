@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
@using Przetrwaj.CommonLibrary.Requests
@using System.IO

<div class="attachments-wrapper">
    <!-- Add Photo Column -->
    <div class="attachment-column add-column">
        <label for="image-upload" class="white-button-blue-text add-photo-btn" tabindex="0" @onkeydown="OnLabelKeyDown">
            Dodaj zdjęcie
        </label>
        <InputFile id="image-upload" OnChange="OnFilesSelected" multiple accept=".jpg,.jpeg,.png,.gif,.webp,image/*" style="display: none;" />
    </div>

    <!-- Attachment Columns -->
    @foreach (var wrapper in attachments)
    {
        <div class="attachment-column">
            <button type="button" class="white-button-red-text remove-photo-btn" @onclick="() => RemoveAttachment(wrapper)">
                Usuń
            </button>
            
            <div class="thumbnail-container">
                @if (!string.IsNullOrEmpty(wrapper.PreviewUrl))
                {
                    <img src="@wrapper.PreviewUrl" alt="Podgląd załącznika" class="thumbnail-img" />
                }
                else
                {
                    <div class="thumbnail-placeholder">
                        <i class="fa fa-spinner fa-spin"></i>
                    </div>
                }
            </div>

            <input type="text" 
                   class="description-input" 
                   placeholder="Opis zdjęcia ..." 
                   @bind="wrapper.Item.AltDescription" 
                   @bind:event="oninput" />
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnAttachmentsChanged { get; set; }

    private List<AttachmentWrapper> attachments = new();

    // Queryable property for the parent page
    public List<AttachmentItem> Items => attachments.Select(w => w.Item).ToList();

    private class AttachmentWrapper
    {
        public required AttachmentItem Item { get; set; }
        public string? PreviewUrl { get; set; }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        // Allow up to 10 files
        var files = e.GetMultipleFiles(10).Where(f => f.ContentType.StartsWith("image/"));

        foreach (var file in files)
        {
            if (attachments.Count >= 10)
                break;

            var item = new AttachmentItem
            {
                File = file,
                AltDescription = string.Empty
            };

            var wrapper = new AttachmentWrapper
            {
                Item = item,
                PreviewUrl = null // Will load asynchronously
            };

            attachments.Add(wrapper);

            // Load preview asynchronously to not block the UI
            _ = LoadPreviewAsync(wrapper, file);
        }

        StateHasChanged();
        
        if (OnAttachmentsChanged.HasDelegate)
        {
            await OnAttachmentsChanged.InvokeAsync();
        }
    }

    private async Task LoadPreviewAsync(AttachmentWrapper wrapper, IBrowserFile file)
    {
        try
        {
            // Resize to standard size (e.g., max 400x400) to keep base64 memory footprint low
            var resizedFile = await file.RequestImageFileAsync("image/png", 400, 400);
            using var stream = resizedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            
            var base64 = Convert.ToBase64String(ms.ToArray());
            wrapper.PreviewUrl = $"data:image/png;base64,{base64}";
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading image preview: {ex.Message}");
            // Set a fallback or empty preview
            wrapper.PreviewUrl = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><rect width='100' height='100' fill='%23eee'/><text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' font-family='sans-serif' font-size='10' fill='%23999'>Błąd podglądu</text></svg>";
            StateHasChanged();
        }
    }

    private async Task RemoveAttachment(AttachmentWrapper wrapper)
    {
        attachments.Remove(wrapper);
        StateHasChanged();
        
        if (OnAttachmentsChanged.HasDelegate)
        {
            await OnAttachmentsChanged.InvokeAsync();
        }
    }

    private async Task OnLabelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('image-upload').click()");
        }
    }
}
