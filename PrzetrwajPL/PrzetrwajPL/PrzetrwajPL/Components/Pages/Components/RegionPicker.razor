@namespace PrzetrwajPL.Components.Pages.Components
@using PrzetrwajPL.Models
@inject IHttpClientFactory ClientFactory

<div class="region-picker-box">
    <div class="geo-action-row">
        <button type="button" class="btn-geo" @onclick="RegionFromLocation" disabled="@isGeolocationLoading">
            @if (isGeolocationLoading)
            {
                <i class="fa fa-refresh fa-spin me-2"></i> <span>Lokalizowanie...</span>
            }
            else
            {
                <i class="fa fa-map-marker me-2"></i> <span>Użyj mojej lokalizacji</span>
            }
        </button>
        <span class="active-region-badge">@SelectedRegionName</span>
    </div>

    <div class="cascade-selectors">
        @* Layer 1: Województwo *@
        <div class="selector-group">
            <label>Województwo:</label>
            <select class="form-control-region" @onchange="HandleWojSelect" value="@SelectedWojId">
                <option value="">-- Wybierz Województwo --</option>
                @if (wojewodztwa != null)
                {
                    @foreach (var woj in wojewodztwa)
                    {
                        <option value="@woj.Id">@woj.Name</option>
                    }
                }
            </select>
        </div>

        @* Layer 2: Powiat *@
        <div class="selector-group">
            <label>Powiat:</label>
            <select class="form-control-region" @onchange="HandlePowSelect" value="@SelectedPowId" disabled="@(powiaty == null)">
                <option value="">-- @(powiaty == null ? "Najpierw wybierz województwo" : "Wybierz Powiat") --</option>
                @if (powiaty != null)
                {
                    @foreach (var pow in powiaty)
                    {
                        <option value="@pow.Id">@pow.Name</option>
                    }
                }
            </select>
        </div>

        @* Layer 3: Gmina *@
        <div class="selector-group">
            <label>Gmina:</label>
            <select class="form-control-region" @onchange="HandleGmiSelect" value="@SelectedGmiId" disabled="@(gminy == null)">
                <option value="">-- @(gminy == null ? "Najpierw wybierz powiat" : "Wybierz Gminę") --</option>
                @if (gminy != null)
                {
                    @foreach (var gmi in gminy)
                    {
                        <option value="@gmi.Id">@gmi.Name</option>
                    }
                }
            </select>
        </div>
    </div>
</div>