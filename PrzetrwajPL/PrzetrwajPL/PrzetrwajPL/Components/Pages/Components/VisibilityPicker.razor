@namespace PrzetrwajPL.Components.Pages.Components
@using Przetrwaj.CommonLibrary.Models

<div class="picker-box">
	<div class="cascade-selectors">
		<label>Widoczność na skalę</label>
		@* min *@
		<div class="selector-group">
			@* <label>Od</label> *@
			<select class="form-control-region button" @bind:get="Min" @bind:set="HandleMinChanged">
				<option value="@RegionPrecision.GMI">Gmina</option>
				<option value="@RegionPrecision.POW">Powiat</option>
				<option value="@RegionPrecision.WOJ">Województwo</option>
				<option value="@RegionPrecision.PL">Polska</option>
			</select>
		</div>

		@* max *@
		<div class="selector-group">
			<label>Do</label>
			<select class="form-control-region button" @bind:get="Max" @bind:set="HandleMaxChanged">
				<option value="@RegionPrecision.GMI">Gmina</option>
				<option value="@RegionPrecision.POW">Powiat</option>
				<option value="@RegionPrecision.WOJ">Województwo</option>
				<option value="@RegionPrecision.PL">Polska</option>
			</select>
		</div>
	</div>
</div>

@code {
	[Parameter]
	public RegionPrecision Min { get; set; } = RegionPrecision.GMI;
	[Parameter]
	public RegionPrecision Max { get; set; } = RegionPrecision.PL;


	[Parameter] public EventCallback<RegionPrecision> SelectionChanged { get; set; }

	private async Task HandleMinChanged(RegionPrecision newValue)
	{
		Min = newValue;
		if (SelectionChanged.HasDelegate)
			await SelectionChanged.InvokeAsync(newValue);
	}

	private async Task HandleMaxChanged(RegionPrecision newValue)
	{
		Max = newValue;
		if (SelectionChanged.HasDelegate)
			await SelectionChanged.InvokeAsync(newValue);
	}
}
