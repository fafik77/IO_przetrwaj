@page "/addPost"
@rendermode InteractiveServer

@namespace PrzetrwajPL.Components.Pages.Components
@using System.Text.RegularExpressions
@using Przetrwaj.CommonLibrary.Consts
@using Przetrwaj.CommonLibrary.Requests
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav

<h3>Dodaj nowe zagrożenie</h3>

<EditForm Model="@model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Tytuł</label>
        <InputText class="form-control" @bind-Value="model.Title" />
		<ValidationMessage For="@(() => model.Title)" style="color:red; font-size: 12px;" />
    </div>

    <div class="mb-3">
        <label>Opis</label>
		<InputTextArea class="form-control" @bind-Value="model.Description" />
		<ValidationMessage For="@(() => model.Description)" style="color:red; font-size: 12px;" />
    </div>

    <div class="mb-3">
        <label>Kategoria</label>
		<DangerCategoryPicker @ref="DangerCategoryPicker" @bind-SelectedCategoryId="model.IdCategory" />
		<ValidationMessage For="@(() => model.IdCategory)" style="color:red; font-size: 12px;" />
    </div>

    <div class="mb-3">
        <label>Własna kategoria (opcjonalnie)</label>
		<InputText class="form-control" @bind-Value="model.CustomCategory" />
		<ValidationMessage For="@(() => model.CustomCategory)" style="color:red; font-size: 12px;" />
    </div>

    <div class="mb-3">
        <label>Region</label>
		<RegionPicker @bind-SelectedRegionId="model.IdRegion" />
		<ValidationMessage For="@(() => model.IdRegion)" style="color:red; font-size: 12px;" />
    </div>

    <button class="btn btn-primary" type="submit">Dodaj post</button>
</EditForm>

@if (success && !string.IsNullOrEmpty(newPostId))
{
	<div class="alert alert-success mt-3">
		<h4>Post został dodany!</h4>

		<div class="d-flex gap-2">
			<a href="/addAttachments?post=@newPostId" class="btn btn-outline-primary">
				Dodaj zdjęcia do posta
			</a>

			<a href="/post/@newPostId" class="btn btn-primary">
				Przejdź do posta
			</a>
		</div>
	</div>
}


@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (success)
{
    <div class="alert alert-success mt-3">Post został dodany!</div>
}

@code {
	private EditContext? editContext;
	private ValidationMessageStore? messageStore;
	private DangerCategoryPicker DangerCategoryPicker;

	private AddPostCommand model = new() { Title = "" };
	private string? error;
	private bool success = false;
	private string? newPostId;

	private static readonly Regex InneCategoryRegex = new Regex(
		@"^(inne|inna)(\s+\w+)?$",
		RegexOptions.Compiled | RegexOptions.IgnoreCase
	);

	protected override void OnInitialized()
	{
		editContext = new EditContext(model);
		messageStore = new ValidationMessageStore(editContext);
		// Clear messages when the user changes a field so the error doesn't stick
		editContext.OnFieldChanged += (s, e) => messageStore.Clear(e.FieldIdentifier);
	}

	private async Task HandleSubmit()
	{
		messageStore?.Clear(); // Clear previous manual errors
		error = null;
		success = false;
		if (string.IsNullOrEmpty(model.Title))
		{
			error = "Post musi mieć tytuł";
			return;
		}
		else if (model.IdCategory <= 0)
		{
			error = "Post musi przynależeć do kategori";
			return;
		}
		else if (InneCategoryRegex.IsMatch(DangerCategoryPicker.SelectedCategoryName ?? string.Empty))
		{
			if (string.IsNullOrWhiteSpace(model.CustomCategory) || model.CustomCategory.Length < 3 || model.CustomCategory.Length > 60)
			{
				error = "Własna kategoria musi mieć od 3 do 60 znaków";
				messageStore?.Add(() => model.CustomCategory, error);
				// Notify the context that validation state has changed to show the message in the UI
				editContext?.NotifyValidationStateChanged();
				return;
			}
		}

		try
		{
			var client = ClientFactory.CreateClient(Consts.PrzetrwajApiClientName);
			var response = await client.PostAsJsonAsync("/Posts/Danger", model);

			if (response.IsSuccessStatusCode)
			{
				newPostId = null;
				// The Location header usually looks like: https://api.com/Post/Danger/123
				var location = response.Headers.Location;
				if (location != null)
				{
					// Extract the last part of the URL (the ID)
					newPostId = location.Segments.Last().TrimEnd('/');
					success = true;
				}
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync(); 
                error = $"Nie udało się dodać posta. Kod: {response.StatusCode}, odpowiedź: {msg}";
            }
        }
        catch (Exception ex)
        {
            error = $"Błąd połączenia: {ex.Message}";
        }
    }
}
