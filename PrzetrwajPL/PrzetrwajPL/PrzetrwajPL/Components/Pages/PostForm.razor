@page "/addPost"
@rendermode InteractiveServer

@namespace PrzetrwajPL.Components.Pages.Components
@using PrzetrwajPL.Requests
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav

<h3>Dodaj nowe zagrożenie</h3>

<EditForm Model="@model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Tytuł</label>
        <InputText class="form-control" @bind-Value="model.Title" />
    </div>

    <div class="mb-3">
        <label>Opis</label>
        <InputTextArea class="form-control" @bind-Value="model.Description" />
    </div>

    <div class="mb-3">
        <label>Kategoria</label>
        <DangerCategoryPicker @bind-SelectedCategoryId="model.IdCategory" />
    </div>

    <div class="mb-3">
        <label>Własna kategoria (opcjonalnie)</label>
        <InputText class="form-control" @bind-Value="model.CustomCategory" />
    </div>

    <div class="mb-3">
        <label>Region</label>
        <RegionPicker @bind-SelectedRegionId="model.IdRegion" />
    </div>

    <button class="btn btn-primary" type="submit">Dodaj post</button>
</EditForm>

@if (success && !string.IsNullOrEmpty(newPostId))
{
	<div class="alert alert-success mt-3">
		<h4>Post został dodany!</h4>

		<div class="d-flex gap-2">
			<a href="/addAttachments?post=@newPostId" class="btn btn-outline-primary">
				Dodaj zdjęcia do posta
			</a>

			<a href="/post/@newPostId" class="btn btn-primary">
				Przejdź do posta
			</a>
		</div>
	</div>
}


@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (success)
{
    <div class="alert alert-success mt-3">Post został dodany!</div>
}

@code {
	private AddPostCommand model = new() { Title = "" };
	private string? error;
	private bool success = true; 
	private string? newPostId="wadasd";

	private async Task HandleSubmit()
	{
		error = null;
		success = false;

		try
		{
			var client = ClientFactory.CreateClient("ServerAPI");
			var response = await client.PostAsJsonAsync("/Post/Danger", model);

			if (response.IsSuccessStatusCode)
			{
				newPostId = null;
				// The Location header usually looks like: https://api.com/Post/Danger/123
				var location = response.Headers.Location;
				if (location != null)
				{
					// Extract the last part of the URL (the ID)
					newPostId = location.Segments.Last().TrimEnd('/');
					success = true;
				}
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync(); 
                error = $"Nie udało się dodać posta. Kod: {response.StatusCode}, odpowiedź: {msg}";
            }
        }
        catch (Exception ex)
        {
            error = $"Błąd połączenia: {ex.Message}";
        }
    }
}
