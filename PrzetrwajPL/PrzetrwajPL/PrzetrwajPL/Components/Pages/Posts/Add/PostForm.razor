@page "/add-post-{PostType}"
@* valid values for API are: (danger, resource) *@
@rendermode InteractiveServer
@implements IDisposable

@namespace PrzetrwajPL.Components.Pages.Components
@using System.Text.RegularExpressions
@using Przetrwaj.CommonLibrary.Consts
@using Przetrwaj.CommonLibrary.Requests
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Dodaj nowy post o @PostTypeAboutPl</h3>

<EditForm Model="@model" OnValidSubmit="HandleSubmit">
	<DataAnnotationsValidator />
	<ValidationSummary />

	<div class="mb-3">
		<label>Tytuł</label>
		<InputText class="form-control" @bind-Value="model.Title" />
		<ValidationMessage For="@(() => model.Title)" style="color:red; font-size: 12px;" />
	</div>

	<div class="mb-3">
		<label>Opis</label>
		<InputTextArea class="form-control" @bind-Value="model.Description" />
		<ValidationMessage For="@(() => model.Description)" style="color:red; font-size: 12px;" />
	</div>

	<div class="mb-3">
		<label>Kategoria</label>
		<CategoryPicker @ref="CategoryPicker" @bind-SelectedCategoryId="model.IdCategory" CategoriesTypeToPickPlural="@PostTypePlural" />
		<ValidationMessage For="@(() => model.IdCategory)" style="color:red; font-size: 12px;" />
	</div>

	<div class="mb-3">
		<label>Własna kategoria (Inne)</label>
		<InputText class="form-control" @bind-Value="model.CustomCategory" />
		<ValidationMessage For="@(() => model.CustomCategory)" style="color:red; font-size: 12px;" />
	</div>

	@* Location *@
	<div class="mb-3 border p-3 rounded bg-light">
		<label class="fw-bold d-block mb-2">Lokalizacja zgłoszenia</label>

		<div class="d-flex gap-2 mb-2">
			<button type="button" class="btn btn-outline-secondary btn-sm" @onclick="HandleUseMyLocation">
				<i class="bi bi-geo-alt"></i> Użyj mojej lokalizacji
			</button>
			<button type="button" class="btn btn-outline-primary btn-sm" @onclick="HandleShowMapPicker">
				<i class="bi bi-map"></i> Wybierz lokalizację na mapie
			</button>
		</div>

		@if (latLong != null)
		{
			<div class="alert alert-info py-2 px-3 m-0 mt-2 d-flex justify-content-between align-items-center" style="font-size: 14px;">
				<div>
					<strong>Wybrane współrzędne:</strong>
					Szerokość: @latLong.Lat.ToString("F5")° | Długość: @latLong.Long.ToString("F5")°
				</div>
				<button type="button" class="btn btn-link btn-sm text-primary p-0" @onclick="HandleShowMapPicker">
					Zmień na mapie
				</button>
			</div>
		}
	</div>

	@* Moderator only: Post visibility *@
	<AuthorizeView Policy="@UserRoles.Moderator" Context="Moderator">
		<div class="mb-3">
			<VisibilityPickerSingle @ref="visibilityPickerSingle" />
		</div>
	</AuthorizeView>

	@* Attachments *@
	<div class="card mb-3">
		<ImageAttachments @ref="ImageAttachments" OnAttachmentsChanged="StateHasChanged" />
	</div>

	<button class="btn btn-primary" type="submit"> Dodaj post</button>
</EditForm>


@if (!string.IsNullOrEmpty(error))
{
	<div class="alert alert-danger mt-3">@error</div>
}

@if (!string.IsNullOrEmpty(newPostId))
{
	<div class="alert alert-success mt-3">Post został dodany!</div>
}

@* Popout Map Selector Modal *@
@if (showMap)
{
	<div class="map-modal-overlay" @onclick="CloseMapPicker">
		<div class="map-modal-content" @onclick:stopPropagation>
			<div class="map-modal-header">
				<div>
					<h5 class="map-modal-title mb-1">
						<i class="bi bi-geo-alt-fill text-danger me-1"></i> Wybierz lokalizację na mapie
					</h5>
					<small class="text-muted">Kliknij w dowolnym miejscu na mapie, aby ustawić punkt zdarzenia.</small>
				</div>
				<button type="button" class="map-modal-close-btn" @onclick="CloseMapPicker" aria-label="Zamknij">&times;</button>
			</div>

			<div class="map-modal-body">
				<div id="@(locationPickerMapId)" class="modal-map-container"></div>
			</div>

			<div class="map-modal-footer">
				<div class="map-modal-status">
					@if (latLong != null)
					{
						<span class="text-success fw-bold">
							<i class="bi bi-check-circle-fill me-1"></i> Wybrano: @latLong.Lat.ToString("F5")°, @latLong.Long.ToString("F5")°
						</span>
					}
					else
					{
						<span class="text-muted">
							<i class="bi bi-info-circle me-1"></i> Kliknij na mapie, aby wybrać punkt
						</span>
					}
				</div>
				<div class="d-flex gap-2">
					<button type="button" class="btn btn-secondary btn-sm" @onclick="CloseMapPicker">Zamknij</button>
					<button type="button" class="btn btn-primary btn-sm" @onclick="CloseMapPicker" disabled="@(latLong == null)">
						Zatwierdź lokalizację
					</button>
				</div>
			</div>
		</div>
	</div>
}

