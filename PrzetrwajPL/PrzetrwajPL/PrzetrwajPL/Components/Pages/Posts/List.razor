@page "/list"

@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory
@using Przetrwaj.CommonLibrary.Consts
@using PrzetrwajPL.Components.Pages.Components

<PageTitle>Lokalnie - Przetrwaj PL</PageTitle>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<div style="text-align: center">
	<h1>Widzisz zagrożenie? Zgłoś je!</h1>

	<div class="cascade-selectors">
		<AuthorizeView Policy="@UserRoles.User">
			<Authorized>
				<a href="/addPost">Dodaj Post o Zagrożeniu</a>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="@UserRoles.Moderator">
			<Authorized>
				<a href="/addPost">Dodaj Post o Zasobie</a>
			</Authorized>
		</AuthorizeView>
	</div>
</div>


<div class="filters">
	<div class="picker">
		<RegionPicker @ref="regionPicker" SelectedRegionIdChanged="SelectedRegionScopeChanged" />
	</div>
	<div class="picker">
		<DangerResourceTypePicker @ref="dangerResourceTypePicker" SelectionChanged="SelectedRegionScopeChanged" />

		<VisibilityPicker @ref="visibilityPicker" />
	</div>
	
</div>

<div style="text-align: center">
	<h2>Lista najnowszych informacji w regionie</h2>
</div>
@if (startedLoadingPosts == false && posts == null)
{
	<p style="text-align: center; margin-top: 20px;">Wybierz region oraz typ informacji, który cię interesuje.</p>
}
else if (posts == null)
{
	<p style="text-align: center; margin-top: 20px;">Ładowanie postów...</p>
}
else if (!posts.Any())
{
	<p style="text-align: center; margin-top: 20px;">Brak postów w wybranym regionie.</p>
}
else
{
	@foreach (var post in posts)
	{
		<div class="post">
			<a href="/post/@post.Id">@post.Title</a>
			<span class="down-vote">@post.VoteNegative</span>
			<span class="divide">/</span>
			<span class="up-vote">@post.VotePositive</span>
			<span class="time-right">@post.DateCreated.ToString("dd.MM.yyyy HH:mm")</span>
		</div>
	}
}
@if (!string.IsNullOrEmpty(errorMsg))
{
	<p class="alert alert-danger pre-wrap" style="text-align: center; margin-top: 20px;">@(errorMsg)</p>
}


