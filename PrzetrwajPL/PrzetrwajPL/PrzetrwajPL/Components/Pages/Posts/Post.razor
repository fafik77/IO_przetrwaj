@page "/posts/{Id}"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory ClientFactory
@using Microsoft.AspNetCore.Components.Authorization
@using PrzetrwajPL.Components.Pages.Components
@using Przetrwaj.CommonLibrary.Consts
@inject IJSRuntime JS
@implements IAsyncDisposable

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">


<div class="container">
	@if (isLoading)
	{
		<p style="text-align:center">Ładowanie szczegółów posta...</p>
	}
	else if (post == null)
	{
		<p style="text-align:center">Nie znaleziono posta.</p>
	}
	else
	{
		@* post main info & likes *@
		<div class="post-header-container">
			<div class="post-header-left">
				@if (isEditingPost)
				{
					<input type="text" class="form-control post-title-input" @bind="editPostCommand.Title" placeholder="Tytuł posta..." />
				}
				else
				{
					<h1 class="post-title">@post.Title</h1>
				}
				<div class="post-meta-line">
					@if (post.Region != null)
					{
						<span class="meta-city">@post.Region.Name</span>
					}
					<span class="meta-time">@post.DateCreated.ToWarsawTime().ToString("HH:mm")</span>
					<span class="meta-date">@post.DateCreated.ToWarsawTime().ToString("dd.MM.yyyy")</span>
					@if (post.Author != null)
					{
						<UserModerationMenu UserId="@post.Author.Id" 
											UserName="@($"{post.Author.Name} {post.Author.Surname}")" 
											IsModerator="@isModerator" 
											OnUserBanned="LoadData" 
											Class="meta-author" />
					}
				</div>
				<div class="post-category-line">
					@if (isEditingPost && post.Category?.IsCustom == true)
					{
						<input type="text" class="form-control post-category-input" @bind="editPostCommand.CustomCategory" placeholder="Własna kategoria..." />
					}
					else
					{
						@post.Category?.Name
					}
				</div>
				@if (post.LatLong != null)
				{
					<div class="post-map-preview-wrapper" @onclick="OpenBigMap" title="Kliknij aby otworzyć punkt na mapie">
						<div id="postMiniMap" class="post-mini-map"></div>
						<div class="map-overlay-badge">
							<i class="fa fa-map-marker"></i> Kliknij aby otworzyć punkt na mapie
						</div>
					</div>
				}
				@if (isAuthorOfPost)
				{
					<div class="author-actions mt-2">
						@if (!isEditingPost)
						{
							<button type="button" class="btn-edit-post" @onclick="StartEditPost">
								<i class="fa fa-pencil"></i> Edytuj
							</button>
							<a href="/posts/@post.Id/add-attachments" class="white-button-blue-text add-photo-btn-extracted">
								<i class="fa fa-plus-circle"></i> Dodaj zdjęcie
							</a>
						}
						else
						{
							<div class="post-edit-actions">
								<button type="button" class="blue-button-white-text btn-save-post" @onclick="() => UpdatePost(editPostCommand)" disabled="@isSavingPost">
									<i class="fa fa-check"></i> Zapisz
								</button>
								<button type="button" class="btn-cancel-post" @onclick="CancelEditPost" disabled="@isSavingPost">
									<i class="fa fa-times"></i> Anuluj
								</button>
								<button type="button" class="red-button-white-text btn-delete-post" @onclick="DeletePost" disabled="@isSavingPost">
									<i class="fa fa-trash"></i> Usuń post
								</button>
							</div>
						}
					</div>
				}
				@if (!string.IsNullOrEmpty(postValidationErrorMessage))
				{
					<div class="alert alert-danger mt-2 py-1 px-2" style="font-size: 14px;">
						@postValidationErrorMessage
					</div>
				}
			</div>
			
			<div class="post-header-right">
				<div class="vote-actions-container">
					<AuthorizeView>
						<NotAuthorized>
							<div class="vote-section">
								<button class="upVoteButt" disabled title="Potwierdzeń">
									<i class="fa fa-thumbs-up"></i> @post.VotePositive
								</button>
								<button class="downVoteButt" disabled title="Odwołań">
									<i class="fa fa-thumbs-down"></i> @post.VoteNegative
								</button>
							</div>
						</NotAuthorized>
						<Authorized>
							<div class="vote-section">
								<button class="upVoteButt" disabled=@HasVoted title=@GetUpVoteButtonTitle()>
									<i class="fa fa-thumbs-up"></i> <div style="color:black">@post.VotePositive</div>
								</button>
								<button class="downVoteButt" disabled=@HasVoted title=@GetDownVoteButtonTitle()>
									<i class="fa fa-thumbs-down"></i>  <div style="color:black">@post.VoteNegative</div>
								</button>
							</div>
						</Authorized>
					</AuthorizeView>

					<AuthorizeView Policy="@UserRoles.Moderator">
						<Authorized>
							<button type="button" class="btn-archive-post" @onclick="ArchivePost" disabled="@isArchivingPost">
								<i class="fa fa-archive"></i> Archiwizuj
							</button>
						</Authorized>
					</AuthorizeView>
				</div>
			</div>
		</div>

		<div class="post-description-container">
			@if (isEditingPost)
			{
				<textarea class="form-control post-description-textarea" rows="5" @bind="editPostCommand.Description" placeholder="Opis posta..."></textarea>
			}
			else
			{
				<p class="post-description-text">@post.Description</p>
			}
		</div>

		@* Horizontal scrolling images *@
		<div class="attachments-scroll-wrapper">
			@if (post.Attachments != null && post.Attachments.Any(a => a != null && !string.IsNullOrEmpty(a.FileURL)))
			{
				@foreach (var attachment in post.Attachments)
				{
					if (attachment != null && !string.IsNullOrEmpty(attachment.FileURL))
					{
						<div class="attachment-col">
							<img src="@attachment.FileURL" 
								 alt="@attachment.AlternateDescription" 
								 class="thumbnail-img" 
								 @onclick="() => ShowFullScreenImage(attachment.FileURL)" />
							
							<span class="attachment-desc">
								@(string.IsNullOrWhiteSpace(attachment.AlternateDescription) ? "Opis zdjęcia..." : attachment.AlternateDescription)
							</span>
						</div>
					}
				}
			}
			else
			{
				<p class="text-muted">Brak załączonych zdjęć.</p>
			}
		</div>

		@* Komentarze *@
		<div class="comments-section">
			<h3>Komentarze (@(post.Comments?.Count() ?? 0))</h3>
			
			<AuthorizeView>
				<Authorized>
					<button class="add-comment-trigger-btn" @onclick="ToggleCommentForm">
						@if (showCommentForm)
						{
							<span>Anuluj</span>
						}
						else
						{
							<i class="fa fa-plus-circle"></i> <span>Dodaj komentarz</span>
						}
					</button>
				</Authorized>
			</AuthorizeView>

			@if (showCommentForm)
			{
				<div class="add-comment-box">
					<textarea @bind="newCommentContent" placeholder="Wpisz treść komentarza..." class="form-control"></textarea>
					<button class="btn-send" @onclick="SubmitComment" disabled="@isSendingComment">Wyślij</button>
				</div>
			}

			<div class="comments-list">
				@if (post.Comments != null && post.Comments.Any())
				{
					@foreach (var comment in post.Comments)
					{
						<div class="comment-item">
							<div class="comment-header">
								@if (string.IsNullOrWhiteSpace(comment.Author?.Id))
								{
									<span class="comment-author">Anonymus</span>
								}
								else
								{
									<UserModerationMenu UserId="@comment.Author.Id" 
														UserName="@($"{comment.Author.Name} {comment.Author.Surname}")" 
														IsModerator="@isModerator" 
														OnUserBanned="LoadData" 
														Class="comment-author" />
								}
								<span class="comment-time">@FormatCommentTime(comment.DateCreated)</span>
								@if(comment.AuthorId.Equals(currentUserId, StringComparison.OrdinalIgnoreCase))
								{
									@if (!comment.IsEditing)
									{
										<button type="button" class="btn-edit-comment" @onclick="() => StartEditComment(comment)">edytuj</button>
									}
								}
							</div>
							@if (comment.IsEditing)
							{
								<div class="comment-edit-actions">
									<button type="button" class="btn-update-comment" @onclick="() => UpdateComment(comment)">Aktualizuj</button>
									<button type="button" class="btn-cancel-comment" @onclick="() => CancelEditComment(comment)">Anuluj</button>
								</div>
								<div class="comment-body">
									<textarea @bind="comment.InEditComment" class="form-control comment-edit-textarea" rows="3"></textarea>
								</div>
							}
							else
							{
								<div class="comment-body">
									@comment.Comment
								</div>
							}
						</div>
					}
				}
				else
				{
					<p class="text-muted">Brak komentarzy.</p>
				}
			</div>
		</div>

		@* fullscreen image *@
		@if (!string.IsNullOrEmpty(fullScreenImageUrl))
		{
			<div class="lightbox-overlay" @onclick="CloseFullScreenImage">
				<div class="lightbox-content" @onclick:stopPropagation>
					<img src="@fullScreenImageUrl" alt="Full screen preview" class="lightbox-img" />
					<button class="lightbox-close-btn" @onclick="CloseFullScreenImage">&times;</button>
				</div>
			</div>
		}

		@* fullscreen interactive map modal *@
		@if (showBigMapModal && post.LatLong != null)
		{
			<div class="map-modal-overlay" @onclick="CloseBigMap">
				<div class="map-modal-content" @onclick:stopPropagation>
					<div class="map-modal-header">
						<h3 class="map-modal-title">Lokalizacja: @post.Title</h3>
						<button type="button" class="map-modal-close-btn" @onclick="CloseBigMap">&times;</button>
					</div>
					<div id="postBigMap" class="map-modal-body"></div>
				</div>
			</div>
		}
	}
</div>
