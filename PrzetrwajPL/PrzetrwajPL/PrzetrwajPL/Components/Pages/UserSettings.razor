@page "/settings"
@rendermode InteractiveServer

@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@using Przetrwaj.CommonLibrary.Consts
@using PrzetrwajPL;
@using PrzetrwajPL.Components.Pages.Components
@using Microsoft.AspNetCore.Authentication;
@using Microsoft.AspNetCore.Authentication.Cookies;
@using Microsoft.AspNetCore.Components;
@using System.Security.Claims;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<div class="container">
	<div class="inContainer">
		<h2 style="text-align:center; font-weight:bold;">Ustawienia użytkownika</h2>
		<EditForm Model="@UserUpdateRequest" OnValidSubmit="HandleUpdate" FormName="updateForm" OnInvalidSubmit="HandleInvalid">
			<DataAnnotationsValidator />
			@if (!string.IsNullOrEmpty(successMessage))
			{
				<div class="alert alert-info pre-wrap" role="alert" style="text-align:center;">
					@successMessage
				</div>
			}
			@if (!string.IsNullOrEmpty(errorMessage))
			{
				<div class="alert alert-danger pre-wrap" role="alert" style="color: black; text-align:center;">@errorMessage</div>
			}

			@* Imię *@
			<label for="name">Imie:</label><br />
			<InputText @bind-Value="UserUpdateRequest.Name" id="name" placeholder="Podaj imie" class="form-control" autocomplete="given-name" />
			<ValidationMessage For="@(() => UserUpdateRequest.Name)" style="color:red; font-size: 12px;" />

			@* Nazwisko *@
			<label for="surname">Nazwisko:</label><br />
			<InputText @bind-Value="UserUpdateRequest.Surname" id="surname" placeholder="Podaj nazwisko" class="form-control" autocomplete="family-name" />
			<ValidationMessage For="@(() => UserUpdateRequest.Surname)" style="color:red; font-size: 12px;" />

			@* Email *@
			<label for="email">Email:</label><br />
			<InputText @bind-Value="UserUpdateRequest.Email" id="email" placeholder="Podaj email" class="form-control" autocomplete="username" />
			<ValidationMessage For="@(() => UserUpdateRequest.Email)" style="color:red; font-size: 12px;" />

			@* Region (Gmina) *@
			<label for="region">Twoja lokalizacja:
				@* Nazwa gminy (button) *@
				<button type="button" class="btn-toggle-picker" @onclick="ToggleRegionPicker">
					<i class="fa fa-map-marker me-2"></i>
					@(myRegionPicker?.SelectedRegionName ?? "Wczytywanie lokalizacji...")
					<i class="fa @(isRegionPickerOpen ? "fa-chevron-up" : "fa-chevron-down") ms-2" style="font-size: 11px;"></i>
				</button>
			</label>
			<div class="picker-container">
				@* Picker wraz z animacją *@
				<div class="picker-slider @(ShouldShowRegionPicker() ? "expanded" : "collapsed")">
					<div class="picker-inner-content">
						<div class="picker">
							<RegionPicker @ref="myRegionPicker" SelectedRegionIdChanged="HandleRegionChanged" />
						</div>
					</div>
				</div>
			</div>

			@* Preferencje *@
			<label for="impediments">Wybierz kategorie które ciebie bardziej interesują:
				<button type="button" class="btn-toggle-picker" @onclick="TogglePreferencesPicker">
					Kategorie
					<i class="fa @(isPreferencesCheckboxGridOpen ? "fa-chevron-up" : "fa-chevron-down") ms-2" style="font-size: 11px;"></i>
				</button>
			</label>
			<div>
				<CheckboxGrid @ref="preferencesCheckboxGrid"/>
			</div>

			@* Stare hasło *@
			<label for="oldPassword">Stare hasło</label>
			<InputText type="password" @bind-Value="UserUpdateRequest.OldPassword" id="oldPassword" placeholder="Podaj stare hasło" class="isform-control" autocomplete="current-password" />
			<ValidationMessage For="@(() => UserUpdateRequest.OldPassword)" style="color:red; font-size: 12px;" />

			@* Nowe hasło *@
			<label for="newPisassword">Nowe hasło</label>
			<InputText type="password" @bind-Value="UserUpdateRequest.NewPassword" id="newPassword" placeholder="Podaj nowe hasło" class="form-control" autocomplete="new-password" />
			<ValidationMessage For="@(() => UserUpdateRequest.NewPassword)" style="color:red; font-size: 12px;" />

			@* Powtórz nowe hasło *@
			<label for="newPassword">Powtórz nowe hasło</label>
			<InputText type="password" @bind-Value="UserUpdateRequest.ConfirmPassword" id="newPasswordConfirm" placeholder="Powtórz nowe hasło" class="form-control" autocomplete="new-password" />
			<ValidationMessage For="@(() => UserUpdateRequest.ConfirmPassword)" style="color:red; font-size: 12px;" />

			@* Grupa przycisków akcji obok siebie *@
			<div class="action-buttons-group" style="display: flex; gap: 12px; justify-content: center; align-items: center;">
				<button type="submit" class="white-button-blue-text" disabled="@isLoading">
					@if (isLoading)
					{
						<span>Zapisuje zmiany...</span>
					}
					else
					{
						<span>Zapisz zmiany</span>
					}
				</button>

				<button type="button" class="blue-button-white-text" @onclick="ConfirmAndLogoutAll">
					Wyloguj wszystkie sesje
				</button>
			</div>
			<br /><br />
		</EditForm>
	</div>
</div>