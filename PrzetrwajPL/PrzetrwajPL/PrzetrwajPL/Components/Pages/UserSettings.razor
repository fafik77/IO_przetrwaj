@page "/settings"

@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using PrzetrwajPL;
@using PrzetrwajPL.Models
@using PrzetrwajPL.Components.Pages.Components
@using PrzetrwajPL.Requests
@using Microsoft.AspNetCore.Authentication;
@using Microsoft.AspNetCore.Authentication.Cookies;
@using Microsoft.AspNetCore.Components;
@using System.Security.Claims;

<div class="container">
	<div class="inContainer">
		<h2 style="text-align:center; font-weight:bold;">Ustawienia użytkownika</h2>
	<p>Tu możesz zmienić swoje ustawienia użytkownika.</p>
	<EditForm Model="@userUpdateRequest" OnValidSubmit="HandleUpdate" FormName="updateForm">
		<DataAnnotationsValidator />
		@if (!string.IsNullOrEmpty(errorMessage))
		{
			<div class="alert alert-danger pre-wrap" role="alert" style="color: black; text-align:center;">@errorMessage</div>
		}
		<label for="name">Imie:</label><br />
			<InputText @bind-Value="userUpdateRequest.Name" id="name" placeholder="Podaj imie" class="form-control" /><br /><br />

		<label for="surname">Nazwisko:</label><br />
			<InputText @bind-Value="userUpdateRequest.Surname" id="surname" placeholder="Podaj nazwisko" class="form-control" /><br /><br />

		<label for="email">Email:</label><br />
			<InputText @bind-Value="userUpdateRequest.Email" id="email" placeholder="Podaj email" class="form-control" /><br /><br />

		<label for="region">Twoja lokalizacja:</label><br />
			<div class="picker-conteiner">
				<div class="picker">
					<RegionPicker SelectedRegionIdChanged="@(id => userUpdateRequest.IdRegion = id)" />
				</div>
			</div><br /><br />

		<label for="oldPassword">Stare hasło</label>
			<InputText type="password" @bind-Value="userUpdateRequest.NewPassword" id="newPassword" placeholder="Podaj nowe hasło" class="form-control" /><br /><br />

		<label for="newPassword">Nowe hasło</label>
			<InputText type="password" @bind-Value="userUpdateRequest.OldPassword" id="oldPassword" placeholder="Podaj stare hasło" class="form-control" /><br /><br />
			<ValidationMessage For="@(() => userUpdateRequest.OldPassword)" style="color:red; font-size: 12px;" /><br />

		<button type="submit" disabled="@isLoading">
			@if (isLoading)
			{
				<span>Zapisuje zmiany...</span>
			}
			else
			{
				<span>Zapisz zmiany</span>
			}
		</button><br /><br />
	</EditForm>
	</div>
</div>


@code {
	private UpdateAccountCommand userUpdateRequest { get; set; } = new UpdateAccountCommand();
	private bool isLoading = false;
	private string errorMessage = string.Empty;

	private async Task HandleUpdate()
	{
		isLoading = true;
		try
		{
			var client = ClientFactory.CreateClient("ServerAPI");
			var response = await client.PutAsJsonAsync("/Account", userUpdateRequest);
			if (response.IsSuccessStatusCode)
			{
				NavigationManager.NavigateTo("/");
			}
			else
			{
				var errorText = await response.Content.ReadFromJsonAsync<ExceptionCasting>();
				errorMessage = errorText?.Error.Message;
			}
		}
		catch (Exception ex)
		{
			errorMessage = $"Błąd połączenia: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}
}
