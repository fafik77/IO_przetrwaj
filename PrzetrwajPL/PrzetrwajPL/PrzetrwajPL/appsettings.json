{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"ASPNETCORE": {
		"UseSSL": true // configure for https
	},
	"OAuth": { //fill the propper values from Secrets
		"Google": {
			"ClientId": ""
		}
